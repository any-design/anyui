{
  "name": "@any-design/anyui",
  "version": "0.5.2",
  "type": "module",
  "author": "any-design",
  "description": "A cute multi-framework UI component library",
  "files": [
    "dist",
    "styles",
    "README.md",
    "README-zh_CN.md",
    "LICENSE"
  ],
  "maintainers": [
    {
      "name": "backrunner",
      "url": "https://github.com/backrunner"
    }
  ],
  "keywords": [
    "vue",
    "react",
    "svelte",
    "ui",
    "library",
    "design-system",
    "cute"
  ],
  "homepage": "https://github.com/any-design/anyui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/any-design/anyui.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@12.3.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "new": "node ./scripts/new.mjs",
    "start": "pnpm run dev",
    "dev": "node ./scripts/dev.mjs",
    "clean": "rimraf dist styles packages/*/dist",
    "generate": "node ./scripts/generate-framework-packages.mjs",
    "build": "turbo run build",
    "dist": "pnpm run clean && pnpm run build",
    "build:website": "pnpm --filter @any-design/anyui-website build:website",
    "serve": "pnpm --filter @any-design/anyui-website serve",
    "lint": "turbo run lint",
    "lint-fix": "turbo run lint-fix",
    "typecheck": "turbo run typecheck",
    "test:e2e": "playwright test -c packages/testground/playwright.config.ts",
    "test:e2e:headed": "playwright test -c packages/testground/playwright.config.ts --headed",
    "test:e2e:ui": "playwright test -c packages/testground/playwright.config.ts --ui",
    "test:website": "playwright test -c packages/website/playwright.config.ts",
    "audit": "pnpm audit",
    "check:package": "node scripts/check-package.mjs"
  },
  "main": "./dist/vue/anyui.mjs",
  "module": "./dist/vue/anyui.mjs",
  "types": "./dist/vue/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/anyui.mjs",
      "default": "./dist/vue/anyui.mjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/anyui.mjs",
      "default": "./dist/vue/anyui.mjs"
    },
    "./resolver": {
      "types": "./dist/vue/resolver.d.ts",
      "import": "./dist/vue/resolver.mjs",
      "require": "./dist/vue/resolver.cjs"
    },
    "./vue/resolver": {
      "types": "./dist/vue/resolver.d.ts",
      "import": "./dist/vue/resolver.mjs",
      "require": "./dist/vue/resolver.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "default": "./dist/react/index.mjs"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "import": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./styles/*": "./styles/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "styles/**/*.css",
    "styles/**/*.scss",
    "**/*.svelte"
  ],
  "license": "MIT",
  "dependencies": {
    "async-validator": "^4.2.5",
    "color": "^5.0.3",
    "mitt": "^3.0.1",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@iconify/react": "^6.0.2",
    "@iconify/svelte": "^5.2.1",
    "@iconify/vue": "^5.0.1",
    "@popperjs/core": "^2.11.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "svelte": "^5.56.4",
    "vue": "^3.5.35"
  },
  "peerDependenciesMeta": {
    "@iconify/react": {
      "optional": true
    },
    "@iconify/svelte": {
      "optional": true
    },
    "@iconify/vue": {
      "optional": true
    },
    "@popperjs/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@iconify/react": "^6.0.2",
    "@iconify/svelte": "^5.2.2",
    "@iconify/vue": "^5.0.1",
    "@playwright/test": "^1.63.0",
    "@popperjs/core": "^2.11.8",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/color": "^4.2.1",
    "@types/node": "^26.4.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "chalk": "^6.0.0",
    "cross-env": "^10.1.0",
    "ejs": "^6.0.1",
    "fs-extra": "^11.4.0",
    "inquirer": "^14.2.1",
    "prettier": "3.9.6",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "sass": "^1.104.0",
    "svelte": "^5.57.0",
    "terser": "^5.51.2",
    "tsup": "^8.5.1",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vite-plugin-gfont": "^0.2.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
