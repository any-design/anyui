{
  "name": "@any-design/anyui-website",
  "version": "0.5.2",
  "private": true,
  "description": "Official website and docs for AnyUI",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build:website": "astro build && pnpm --filter @any-design/anyui-testground exec vite build",
    "serve": "astro preview",
    "clean": "rimraf dist",
    "typecheck": "astro check && vue-tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/svelte": "^9.0.1",
    "@astrojs/vue": "^7.0.2",
    "astro": "^7.3.1",
    "shiki": "4.4.3",
    "wrangler": "^4.129.0"
  }
}
