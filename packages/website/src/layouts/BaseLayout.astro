---
import { ClientRouter } from 'astro:transitions';
import BrandLogo from '../components/BrandLogo.astro';
import BrandLogoMark from '../components/BrandLogoMark.astro';
import SiteNav from '../components/vue/SiteNav.vue';
import MobileNavDrawer from '../components/vue/MobileNavDrawer.vue';
import {
  SITE,
  breadcrumbJsonLd,
  organizationJsonLd,
  pageSeo,
  webPageJsonLd,
  websiteJsonLd,
  type BreadcrumbItem,
  type SchemaType,
} from '../data/seo';

import '../styles/site.scss';

interface MenuGroupItem {
  label: string | { en: string; zh?: string };
  value: string;
  href?: string;
}
interface MenuGroup {
  label: string | { en: string; zh?: string };
  items: MenuGroupItem[];
}

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  active?: string;
  ogType?: 'website' | 'article';
  schemaType?: SchemaType;
  breadcrumbs?: BreadcrumbItem[];
  structuredData?: Array<Record<string, unknown>>;
  robots?: string;
  mobileNavMenuGroups?: MenuGroup[];
  mobileNavMenuActive?: string;
  mobileNavMenuTitle?: string;
  mobileNavMenuKind?: 'docs' | 'components';
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  active = '',
  ogType,
  schemaType = 'WebPage',
  breadcrumbs = [],
  structuredData = [],
  robots = 'index, follow, max-image-preview:large',
  mobileNavMenuGroups,
  mobileNavMenuActive,
  mobileNavMenuTitle,
  mobileNavMenuKind,
} = Astro.props;

const seo = pageSeo({ title, description, path: canonicalPath });
const hasMobileMenu = Boolean(mobileNavMenuGroups && mobileNavMenuGroups.length > 0);
const resolvedOgType = ogType ?? (schemaType === 'TechArticle' ? 'article' : 'website');
const jsonLd = [
  organizationJsonLd(),
  websiteJsonLd(),
  webPageJsonLd({
    schemaType,
    title: seo.title,
    description: seo.description,
    canonicalUrl: seo.canonicalUrl,
  }),
  ...(breadcrumbs.length > 0 ? [breadcrumbJsonLd(breadcrumbs)] : []),
  ...structuredData,
];
const criticalThemeCss =
  "html { background: #f8f8fa; color: #202426; } html[theme='dark'] { background: #1a1a1d; color: #ebeef1; } body { background: transparent; }";
---

<!doctype html>
<html lang="en" theme="light" data-lang="en" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="robots" content={robots} />
    <meta name="author" content={SITE.author} />
    <meta name="application-name" content={SITE.name} />
    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="canonical" href={seo.canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonicalUrl} />
    <meta property="og:image" content={new URL(SITE.image.path, SITE.url).toString()} />
    <meta property="og:image:secure_url" content={new URL(SITE.image.path, SITE.url).toString()} />
    <meta property="og:image:type" content={SITE.image.type} />
    <meta property="og:image:width" content={String(SITE.image.width)} />
    <meta property="og:image:height" content={String(SITE.image.height)} />
    <meta property="og:image:alt" content={SITE.image.alt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={new URL(SITE.image.path, SITE.url).toString()} />
    <meta name="twitter:image:alt" content={SITE.image.alt} />
    {jsonLd.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <ClientRouter fallback="swap" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=optional"
      media="print"
      onload="this.media='all'"
    />
    <script is:inline>
      (() => {
        try {
          const prefs = JSON.parse(localStorage.getItem('anyui-site-prefs') || '{}') || {};
          const root = document.documentElement;
          root.setAttribute('theme', prefs.dark === true ? 'dark' : 'light');
          if (prefs.glass === true) root.setAttribute('data-anyui-style', 'glass');
          root.lang = prefs.lang === 'zh' ? 'zh-CN' : 'en';
          root.dataset.lang = prefs.lang === 'zh' ? 'zh' : 'en';
        } catch {}
      })();
    </script>
    <style is:inline set:html={criticalThemeCss}></style>
  </head>
  <body data-section={active || 'home'}>
    <a class="skip-link" href="#main-content">Skip to content / 跳转到正文</a>
    <div class="site-backdrop" aria-hidden="true" transition:name="site-backdrop"></div>

    <header class="site-header" transition:name="site-header">
      <div class="site-header__inner">
        <a class="site-header__brand" href="/" aria-label="AnyUI home">
          <BrandLogo />
          <BrandLogoMark />
        </a>
        <SiteNav
          client:load
          transition:persist="site-nav"
          transition:persist-props
          active={active}
        />
        {hasMobileMenu && (
          <MobileNavDrawer
            client:only="vue"
            menu-groups={mobileNavMenuGroups}
            menu-active={mobileNavMenuActive}
            menu-title={mobileNavMenuTitle}
            menu-kind={mobileNavMenuKind}
          />
        )}
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>Made with 🧁 by <a href="https://github.com/any-design">Any Design</a></span>
        <a class="site-footer__github" href="https://github.com/any-design/anyui" target="_blank" rel="noreferrer">
          GitHub
        </a>
        <a href="https://github.com/any-design/anyui">MIT Licensed</a>
      </div>
    </footer>

    <script>
      import '../scripts/site-runtime';
    </script>
  </body>
</html>
